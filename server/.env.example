# Copy this file to .env and fill in real values before running the server.

PORT=4000
CLIENT_URL=http://localhost:5173

# Any long random string. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string

# --- Email (optional) ---
# Daily digest emails are skipped automatically if these are left blank.
# Works with any SMTP provider (Gmail app password, Resend, Mailgun, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Homeroom <reminders@example.com>

# --- Web push (optional) ---
# Generate a keypair with: npm run generate-vapid-keys
# Push notifications are skipped automatically if these are left blank.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 24-hour time (server local time) the daily digest cron runs at.
DIGEST_HOUR=7
DIGEST_MINUTE=0
